# Adresse des Make-Webhooks, an den das Anfrageformular die Daten weiterreicht.
# Diese Datei ist nur ein Muster und enthaelt bewusst keine echte Adresse.
# Die echte Adresse wird in Vercel unter Settings -> Environment Variables gesetzt.
MAKE_WEBHOOK_URL=https://hook.eu2.make.com/hier-deine-webhook-adresse
