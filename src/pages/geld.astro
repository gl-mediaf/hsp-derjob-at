---
import Bild from '../components/Bild.astro';
import Layout       from '../layouts/Layout.astro';
import Nav          from '../components/Nav.astro';
import Footer       from '../components/Footer.astro';
import Faq          from '../components/Faq.astro';
import NgoBand      from '../components/NgoBand.astro';
import Stimmen      from '../components/Stimmen.astro';
import AbschlussCta from '../components/AbschlussCta.astro';
import SeitenHero   from '../components/SeitenHero.astro';
import FotoBand     from '../components/FotoBand.astro';
import VideoBlock   from '../components/VideoBlock.astro';
import { videos }   from '../data/videos';

const folderInhalt = [
  { titel: 'Das Provisionsmodell:',        text: 'Verständlich und auf den Punkt.' },
  { titel: 'Rechenbeispiele:',             text: 'Sieh, wie sich deine Leistung in konkreten Zahlen ausdrückt.' },
  { titel: 'Empfehlerprämien:',            text: 'Freunde einladen und doppelt profitieren – so holst du dir die Extras!' },
  { titel: 'Organisationen im Überblick:', text: 'Alle wichtigen Partner und Infos auf einen Blick.' },
];
---

<Layout
  title="Flexibler Ferienjob – So machst du dein Geld mit Sinn"
  description="Fülle dein Konto in den Ferien auf: provisionsbasiert, ohne Limit und im Schnitt 3.300 € in 4 Wochen."
>
  <Nav />

  <main id="inhalt">
    <SeitenHero
      bild="/images/hero-geld.webp"
      alt="Ein Fundraiser lehnt im Gegenlicht an einer alten Holzwand"
      titel="So machst du dein Geld"
      unterzeile="Fülle dein Konto in den Ferien auf."
    />

    <!-- ══ Einstieg mit Provisionsgrafik ══ -->
    <section class="bg-white pb-[35px] pt-10" aria-labelledby="intro-titel">
      <div class="container-hsp grid items-center gap-x-12 gap-y-10 lg:grid-cols-2">
        <div>
          <h2 id="intro-titel"
              class="text-[30px] font-bold leading-[1.1] text-black sm:text-[40px] sm:leading-[44px]">
            Wie du mit einem flexiblen Ferienjob Geld machst
          </h2>
          <p class="mt-4 text-[17px] font-bold text-hsp-ink sm:text-[19px]">
            Starte in deine Selbständigkeit und arbeite flexibel wann du willst:
          </p>
          <div class="mt-4 max-w-[560px] space-y-4 text-[16px] leading-[1.7] text-hsp-ink sm:text-[18px] sm:leading-[30.6px]">
            <p>Du willst in den Ferien selbst Geld machen, aber nicht irgendwo rumsitzen oder Aufgaben erledigen, die dich nicht weiterbringen?</p>
            <p>Bei diesem flexiblen Ferienjob bist du für eine Hilfsorganisation unterwegs – draußen, im direkten Gespräch mit Menschen.</p>
            <p>Was du sagst, bewirkt etwas. Was du tust, bringt dich weiter. Und was du erreichst, macht sich direkt auf deinem Konto bemerkbar.</p>
          </div>
          <a href="#anfrage" class="btn-primary mt-7 gap-2 px-8 py-3.5 text-[17px]">
            <span aria-hidden="true">↓</span> Mehr Infos
          </a>
        </div>

        <Bild src="/images/geld-verguetung.webp"
             alt="Dein Einsatz: zum Beispiel vier Wochen. Im Schnitt 3.300 € in 4 Wochen."
             sizes="(min-width: 640px) 420px, 340px"
             class="reveal mx-auto w-full max-w-[460px]" />
      </div>
    </section>

    <NgoBand />

    <!-- ══ Geld machen auf deine Art ══ -->
    <section class="bg-white py-[60px]" aria-labelledby="art-titel">
      <div class="container-hsp text-center">
        <h2 id="art-titel"
            class="reveal mb-6 text-[30px] font-bold leading-[1.15] text-hsp-ink sm:text-[44px]">
          Geld machen – auf deine Art
        </h2>
        <p class="reveal mx-auto max-w-[900px] text-[16px] leading-[1.75] text-hsp-body sm:text-[17px]">
          Bei diesem flexiblen Ferienjob entscheidest du selbst, wie du auf Menschen zugehst und wie du
          deine Gespräche führst. Es gibt keine Schablone, keinen vorgeschriebenen Ablauf – dein Einsatz
          macht den Unterschied. Und klar: So gutes Geld macht man hier nicht einfach so. Du brauchst Mut,
          Ausdauer und die Fähigkeit, Menschen ehrlich zu überzeugen – etwas, das nicht jeder kann. Wenn du
          dich reinhängst und dranbleibst, sind Ø 3.300 € in 4 Wochen absolut drin und nach oben gibt es
          kein Limit.
        </p>
      </div>
    </section>

    <!-- ══ Provisionsmodell auf Crew-Foto ══
         Frueher ein tuerkiser Kasten mit zwei Textspalten, in dem der Knopf
         weit rechts am Rand klebte. Jetzt tragen zwei grosse Zahlenkarten die
         Aussage: erst die Kernbotschaft, dann die beiden Punkte als Karten,
         dann mittig der Knopf. -->
    <FotoBand bild="/images/bg-crew-weg.webp" position="center 10%" scrim="rgba(0,0,0,0.62)"
              abstand="py-[60px] sm:py-[90px]">
      <div class="container-hsp text-center" aria-labelledby="provision-titel">

        <h2 id="provision-titel"
            class="reveal mx-auto max-w-[760px] text-[28px] font-bold leading-tight text-white sm:text-[40px]">
          Kein Bock auf Stundenlohn?<br />Hier wird deine Leistung belohnt!
        </h2>

        <div class="reveal mx-auto mt-10 grid max-w-[820px] gap-5 sm:mt-12 sm:grid-cols-2 sm:gap-7">

          <div class="rounded-2xl bg-white/95 px-6 py-8 text-left shadow-[0_10px_40px_rgba(0,0,0,0.25)]">
            <p class="text-[32px] font-bold leading-none text-hsp-teal sm:text-[40px]">
              Kein Limit
            </p>
            <p class="mt-3 text-[17px] font-bold text-hsp-ink sm:text-[19px]">
              Provisionsbasiert
            </p>
            <p class="mt-1.5 text-[15px] leading-relaxed text-hsp-body sm:text-[16px]">
              Was du erreichst, bekommst du – nach oben ist nichts gedeckelt.
            </p>
          </div>

          <div class="rounded-2xl bg-white/95 px-6 py-8 text-left shadow-[0_10px_40px_rgba(0,0,0,0.25)]">
            <p class="text-[32px] font-bold leading-none text-hsp-teal sm:text-[40px]">
              Ø 3.300 €
            </p>
            <p class="mt-3 text-[17px] font-bold text-hsp-ink sm:text-[19px]">
              in 4 Wochen
            </p>
            <p class="mt-1.5 text-[15px] leading-relaxed text-hsp-body sm:text-[16px]">
              So viel machen neue Fundraiser im Schnitt in ihren ersten vier Wochen.
            </p>
          </div>

        </div>

        <p class="reveal mt-10 text-[17px] text-white/90 sm:text-[19px]">Na überzeugt? ✋</p>
        <a href="#anfrage"
           class="btn-primary reveal mt-4 gap-2 px-9 py-4 text-[17px]">
          <span aria-hidden="true">›</span> Zur Anfrage
        </a>

      </div>
    </FotoBand>

    <!-- ══ Film: wie das Kennenlernen ablief ══ -->
    <section class="bg-white py-[70px]" aria-labelledby="film-kennenlernen">
      <div class="container-hsp">
        <h2 id="film-kennenlernen"
            class="reveal mb-3 text-center text-[30px] font-bold leading-[1.15] text-hsp-ink sm:text-[40px]">
          Wie lief das Kennenlernen ab?
        </h2>
        <p class="reveal mx-auto mb-10 max-w-[620px] text-center text-[16px] leading-relaxed text-hsp-body sm:text-[18px]">
          Vier Fundraiser erzählen, was zwischen der Anfrage und dem ersten Einsatz
          passiert ist.
        </p>
        <div class="mx-auto max-w-[880px]">
          <VideoBlock
            video={videos.anfrage}
            poster="/videos/video-anfrage-poster.webp"
            alt="Vier Fundraiser erzählen, wie ihr Kennenlernen und Einstieg ablief"
            dauer="1:42"
          />
        </div>
      </div>
    </section>

    <!-- ══ Provisionsmodell / Folder ══ -->
    <section class="bg-white pb-[70px]" aria-labelledby="folder-titel">
      <div class="container-hsp">
        <p class="reveal text-center text-[17px] text-hsp-body sm:text-[20px]">
          Im Kennenlerngespräch erklären wir dir
        </p>
        <p class="reveal mt-1 text-center text-[24px] leading-tight text-hsp-ink sm:text-[34px]">
          Das Provisionsmodell im Detail:
        </p>
        <h2 id="folder-titel"
            class="reveal mb-12 mt-1 text-center text-[30px] font-bold leading-[1.15] text-hsp-ink sm:text-[44px]">
          Alles Wichtige zu deiner Provision
        </h2>

        <div class="reveal rounded-2xl bg-hsp-light px-7 py-10 sm:px-12 sm:py-12">
          <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
            <div>
              <p class="mb-6 text-[28px] font-bold leading-tight text-hsp-ink sm:text-[40px]">
                Alles auf einen Blick:
              </p>
              <dl class="space-y-4">
                {folderInhalt.map((f) => (
                  <div class="flex items-start gap-3 text-[16px] leading-relaxed text-hsp-ink sm:text-[17px]">
                    <svg class="mt-1.5 h-4 w-4 shrink-0 text-hsp-teal" viewBox="0 0 20 20" fill="none"
                         stroke="currentColor" stroke-width="3" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                      <polyline points="4 11 8 15 16 5" />
                    </svg>
                    <div>
                      <dt class="inline font-bold">{f.titel}</dt>{' '}
                      <dd class="inline">{f.text}</dd>
                    </div>
                  </div>
                ))}
              </dl>
            </div>

            <div class="text-center">
              <Bild src="/images/geld-download.webp"
                   alt="Vorschau des Provisions-Folders auf Tablet und als gedruckte Seiten"
                   sizes="(min-width: 1024px) 460px, 85vw"
                   class="mx-auto w-full max-w-[460px]" />
              <a href="#anfrage" class="btn-primary mt-6 px-8 py-3.5 text-[17px]">Jetzt anfragen</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Stimmen />
    <Faq />
    <AbschlussCta />
  </main>

  <Footer />
</Layout>
