---
import Layout from '../layouts/Layout.astro';

const region = 'Österreich';
const regionCode = 'AT';
---

<Layout
  title="hsp – Der Ferienjob mit dem gewissen Etwas"
  description="Neue Website in Arbeit. Bald mehr an dieser Stelle."
>
  <main class="min-h-screen flex flex-col items-center justify-center px-6 py-16 bg-hsp-light text-center">

    <img src="/images/hsp-logo.svg" alt="hsp" class="h-12 md:h-14 mb-10" />

    <span class="inline-block mb-6 px-3 py-1 rounded-full bg-hsp-lime/15 text-hsp-lime-dark text-xs font-bold tracking-widest uppercase">
      {regionCode} &middot; Platzhalter
    </span>

    <h1 class="text-3xl md:text-5xl font-extrabold text-hsp-dark max-w-2xl leading-tight">
      Hier entsteht die neue Website für {region}.
    </h1>

    <p class="mt-5 max-w-md text-hsp-gray text-base md:text-lg leading-relaxed">
      Diese Seite ist ein Platzhalter. Inhalte, Formular und Tracking folgen in den nächsten Schritten.
    </p>

    <div class="mt-10 h-1 w-16 rounded-full bg-hsp-lime"></div>

    <footer class="mt-14 text-xs text-hsp-gray/70">
      &copy; {new Date().getFullYear()} hsp Die Fundraiser GmbH
    </footer>

  </main>
</Layout>
