---
import AnfrageFormular from './AnfrageFormular.astro';

export interface Props {
  titel?: string;
  unterzeile?: string;
}
const {
  titel = 'Bist du bereit für den Sommer deines Lebens?',
  unterzeile = 'Sichere dir jetzt deinen Platz in der Crew und starte dein Abenteuer als Fundraiser.',
} = Astro.props;

// Foto als CSS-Hintergrund statt als <img> mit loading="lazy": ein solches
// Bild wurde in Chrome nicht geladen, solange es hinter dem Inhalt lag.
const hintergrund = [
  'linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45))',
  "url('/images/cta-sonnenuntergang.webp')",
].join(', ');
---

<section id="anfrage"
         class="bg-hsp-ink bg-cover bg-center bg-no-repeat"
         style={`background-image:${hintergrund};`}
         aria-labelledby="cta-titel">
  <div class="container-hsp py-[70px] sm:py-[90px]">

    <div class="text-center">
      <h2 id="cta-titel"
          class="mx-auto max-w-[1000px] text-[30px] font-bold leading-[1.15] text-white sm:text-[50px] sm:leading-[60px]">
        {titel}
      </h2>
      <p class="mx-auto mt-4 max-w-[727px] text-[17px] font-bold leading-[30px] text-white sm:text-[20px]">
        {unterzeile}
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-[680px] rounded-2xl bg-white px-6 py-8 shadow-[0_12px_50px_rgba(0,0,0,0.3)] sm:px-10 sm:py-10">
      <p class="mb-6 text-center text-[20px] font-bold text-hsp-ink sm:text-[24px]">
        Neugierig? Dann melde dich.
      </p>

      <AnfrageFormular />

      <p class="mt-5 text-center text-[12px] text-hsp-body">
        * Auf Anfragen wird in der Regel innerhalb von 24 Stunden geantwortet
      </p>
    </div>

  </div>
</section>
