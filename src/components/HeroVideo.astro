---
import Bild from './Bild.astro';

/**
 * Hintergrundfilm im Hero.
 *
 * Gezeigt wird zuerst das Standbild. Der Film wird nachgeladen und startet
 * stumm in Schleife, sobald er genug Daten hat - so steht sofort ein Bild und
 * nichts blinkt.
 *
 * Bewusst NICHT geladen wird er
 *   - bei prefers-reduced-motion (Systemeinstellung gegen Bewegung),
 *   - auf schmalen Fenstern unter 640 px, wo er nur Daten kostet,
 *   - bei eingeschaltetem Datensparmodus oder wirklich langsamer Leitung.
 *
 * Zur Leitungspruefung: navigator.connection.effectiveType meldet in Chrome
 * auch auf ordentlichem Anschluss haeufig "3g" - der Wert stammt aus einer
 * laufenden Schaetzung von Antwortzeit und Durchsatz und faellt sehr
 * vorsichtig aus. Wer darauf sperrt, sperrt den Film bei vielen normalen
 * Besuchern aus. Deshalb blocken hier nur noch 2g und slow-2g.
 * In all diesen Faellen bleibt das Standbild stehen. Die Sektion funktioniert
 * also auch ganz ohne Film.
 *
 * Nur MP4: Bei diesem Material fiel die WebM-Fassung groesser aus als H.264,
 * ein zweites Format haette also nur Platz gekostet.
 *
 * Drei Groessen. Wichtig ist vor allem, NICHT hochzurechnen: Eine 1600 Pixel
 * breite Datei auf einem 1920er Bildschirm sieht sichtbar weicher aus als eine
 * native. Deshalb bekommen grosse Fenster 1920, mittlere 1280, kleine 960.
 */
export interface Props {
  poster: string;
  alt:    string;
  basis:  string;   // z. B. /videos/hero - ohne Groesse und Endung
}
const { poster, alt, basis } = Astro.props;
---

<div class="absolute inset-0 -z-10 overflow-hidden" data-hero-film data-basis={basis}>
  <Bild src={poster} alt={alt} sizes="100vw" loading="eager" fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-[center_30%]" />
</div>

<script is:inline>
  (function () {
    var halter = document.querySelector('[data-hero-film]');
    if (!halter) return;

    var ruhig  = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var schmal = matchMedia('(max-width: 639px)').matches;
    var v      = navigator.connection || {};
    var sparen = v.saveData === true || /^(slow-2g|2g)$/.test(v.effectiveType || '');
    if (ruhig || schmal || sparen) return;

    var basis  = halter.getAttribute('data-basis');
    var breite = matchMedia('(min-width: 1281px)').matches ? '1920'
               : matchMedia('(min-width: 961px)').matches  ? '1280'
               : '960';

    var film = document.createElement('video');
    film.muted = true; film.defaultMuted = true;
    film.loop = true; film.autoplay = true; film.playsInline = true;
    film.setAttribute('muted', ''); film.setAttribute('playsinline', '');
    film.preload = 'auto';
    film.setAttribute('aria-hidden', 'true'); film.tabIndex = -1;
    film.className =
      'absolute inset-0 h-full w-full object-cover object-[center_30%] opacity-0 transition-opacity duration-700';

    var q = document.createElement('source');
    q.src = basis + '-' + breite + '.mp4';
    q.type = 'video/mp4';
    film.appendChild(q);

    // Erst einblenden, wenn wirklich Bilder da sind - sonst blitzt Schwarz auf.
    // Zwei Ereignisse, weil je nach Browser mal das eine, mal das andere
    // zuerst kommt, und ein Notnagel nach vier Sekunden: Lieber ein Film,
    // der eine Sekunde ruckelt, als einer, der nie erscheint.
    var sichtbar = false;
    function zeigen() {
      if (sichtbar) return;
      sichtbar = true;
      film.classList.remove('opacity-0');
    }
    film.addEventListener('loadeddata', zeigen, { once: true });
    film.addEventListener('canplay',    zeigen, { once: true });
    setTimeout(function () { if (film.readyState >= 2) zeigen(); }, 4000);

    film.addEventListener('error', function () { film.remove(); });

    halter.appendChild(film);
    var start = film.play();
    if (start && start.catch) start.catch(function () { film.remove(); });
  })();
</script>
