---
import Bild from './Bild.astro';
/**
 * Grosser Videoblock mit Vorschaubild.
 *
 * Der Film liegt auf unserem YouTube-Kanal, das Standbild bei uns im Ordner.
 * Vor dem Klick geht keine Anfrage an Google - erst danach wird der Player
 * ueber youtube-nocookie.com nachgeladen. Die Steuerung dafuer steht in
 * Layout.astro und gilt fuer alle Bloecke mit [data-film-halter].
 *
 * Ohne `video` erscheint ein Platzhalter mit Hinweis. So kann die Stelle im
 * Seitenaufbau schon beurteilt werden, bevor der Film da ist.
 */
export interface Props {
  poster:      string;
  alt:         string;
  video?:      string;   // YouTube-Kennung, z. B. 'l3ksGFkfiX4'
  titel?:      string;
  unterzeile?: string;
  dauer?:      string;
  /**
   * Gruene Kreisblase, die unten rechts ueber den Rand ragt. Traegt eine
   * Zahl - etwa den Durchschnittsverdienst. Sie liegt ueber dem Bild, nimmt
   * aber keine Klicks an, damit der Film weiterhin ueberall startet.
   */
  blase?:      { zahl: string; zusatz: string };
  /**
   * Film im Overlay statt an Ort und Stelle abspielen. Sinnvoll ueberall dort,
   * wo der Block schmal ist - etwa auf der Startseite, wo er nur die halbe
   * Spaltenbreite hat.
   */
  gross?:      boolean;
}
const { poster, alt, video, titel, unterzeile, dauer, gross = false, blase } = Astro.props;
---

<figure class="reveal relative rounded-2xl bg-white shadow-[0_10px_40px_rgba(0,0,0,0.12)]">
  <div class="relative aspect-video overflow-hidden rounded-2xl bg-hsp-ink" data-film-halter>
    <Bild src={poster} alt={alt} sizes="(min-width: 1024px) 880px, 100vw"
          class="absolute inset-0 h-full w-full object-cover" data-film-bild />

    {video ? (
      <button type="button" data-film-start data-film-gross={gross ? '' : undefined} data-video={video}
              class="absolute inset-0 grid place-items-center bg-black/25 transition-colors hover:bg-black/35"
              aria-label={`Video abspielen${titel ? ': ' + titel : ''}`}>
        <span class="grid h-[76px] w-[76px] place-items-center rounded-full bg-white/95 shadow-lg
                     transition-transform duration-200 hover:scale-105">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"
               class="ml-1 text-hsp-ink" aria-hidden="true">
            <path d="M6 4l14 8-14 8V4z" />
          </svg>
        </span>
      </button>
    ) : (
      <div class="absolute inset-0 grid place-items-center bg-black/55 px-6 text-center">
        <div>
          <p class="text-[15px] font-bold uppercase tracking-wide text-hsp-yellow">Platz für das Video</p>
          <p class="mt-2 text-[18px] font-bold text-white sm:text-[20px]">{titel}</p>
          <p class="mx-auto mt-2 max-w-[420px] text-[14px] leading-relaxed text-white/85">
            Der Film ist noch nicht verknüpft. Das Standbild zeigt, wie der
            Abschnitt an dieser Stelle wirkt.
          </p>
        </div>
      </div>
    )}

    {dauer && (
      <span class="pointer-events-none absolute bottom-3 right-3 rounded-md bg-black/70 px-2 py-1
                   text-[12px] font-bold text-white" data-film-dauer>
        {dauer}
      </span>
    )}
  </div>

  {blase && (
    <div class="pointer-events-none absolute -bottom-8 -right-6 z-10 grid h-[132px] w-[132px]
                place-items-center rounded-full bg-hsp-gruen text-center text-white
                shadow-[0_10px_30px_rgba(0,0,0,0.22)] sm:-bottom-10 sm:-right-8 sm:h-[164px] sm:w-[164px]"
         aria-hidden="true">
      <div>
        <p class="text-[20px] font-bold leading-none sm:text-[26px]">{blase.zahl}</p>
        <p class="mt-1 text-[13px] leading-tight sm:text-[15px]">{blase.zusatz}</p>
      </div>
    </div>
  )}

  {(titel || unterzeile) && (
    <figcaption class="px-5 py-4 sm:px-6">
      {titel && <p class="text-[18px] font-bold leading-snug text-hsp-ink sm:text-[20px]">{titel}</p>}
      {unterzeile && <p class="mt-1 text-[15px] leading-relaxed text-hsp-body">{unterzeile}</p>}
    </figcaption>
  )}
</figure>
