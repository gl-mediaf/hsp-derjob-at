  { name: 'YouTube', href: 'https://www.youtube.com/channel/UCtpmRTwr3EPssBipy4o9WLw',
    d: 'M23 12s0-3.2-.4-4.7c-.2-.8-.9-1.5-1.7-1.7C19.3 5.2 12 5.2 12 5.2s-7.3 0-8.9.4c-.8.2-1.5.9-1.7 1.7C1 8.8 1 12 1 12s0 3.2.4 4.7c.2.8.9 1.5 1.7 1.7 1.6.4 8.9.4 8.9.4s7.3 0 8.9-.4c.8-.2 1.5-.9 1.7-1.7.4-1.5.4-4.7.4-4.7zM9.7 15.3V8.7l6.1 3.3-6.1 3.3z' },
  { name: 'Facebook', href: 'https://www.facebook.com/hspderjob',
    d: 'M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.5 2.9h-2.3v7A10 10 0 0022 12z' },
];
const jahr = new Date().getFullYear();
---
<footer class="bg-white pb-16 pt-14 text-hsp-body">
  <div class="container-hsp grid gap-10 sm:grid-cols-2 lg:grid-cols-4">

    <div>
      <h2 class="mb-4 text-[16px] font-bold text-hsp-ink">hsp Gruppe</h2>
      <ul class="text-[14px] sm:space-y-2">
        {gruppe.map((l) => (
          <li>
            <a href={l.href} class="inline-block py-2 transition-colors hover:text-hsp-teal sm:py-0"
               target={l.href.startsWith('http') ? '_blank' : null}
               rel={l.href.startsWith('http') ? 'noopener' : null}>{l.text}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="mb-4 text-[16px] font-bold text-hsp-ink">hsp Der Job</h2>
      <ul class="text-[14px] sm:space-y-2">
        {derJob.map((l) => (
          <li><a href={l.href} class="inline-block py-2 transition-colors hover:text-hsp-teal sm:py-0">{l.text}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="mb-4 text-[16px] font-bold text-hsp-ink">Kontakt</h2>
      <address class="space-y-1 text-[14px] not-italic">
        <p>hsp Die Fundraiser GmbH</p>
        <p>Zielstattstraße 11,</p>
        <p>81379 München</p>
        <p><a href="tel:+498945223420" class="inline-block py-1.5 transition-colors hover:text-hsp-teal sm:py-0">+49 (0) 89 45 22 34 20</a></p>
        <p>
          <a href="mailto:office@hsp-diefundraiser.de" class="inline-block py-1.5 transition-colors hover:text-hsp-teal sm:py-0">
            office@hsp-diefundraiser.de
          </a>
        </p>
      </address>
    </div>

    <div>
      <h2 class="mb-4 text-[16px] font-bold text-hsp-ink">Join us</h2>
      <ul class="text-[14px] sm:space-y-2">
        <li class="py-2 sm:py-0">© {jahr} hsp DIE FUNDRAISER GmbH</li>
        <li>
          <a href="/impressum"
             class="inline-block py-2 transition-colors hover:text-hsp-teal sm:py-0">Impressum</a>
        </li>
        <li>
          <a href="/datenschutz"
             class="inline-block py-2 transition-colors hover:text-hsp-teal sm:py-0">Datenschutz</a>
        </li>
      </ul>

      <ul class="mt-4 flex items-center gap-1 sm:mt-6 sm:gap-2">
        {social.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener"
               class="grid h-11 w-11 place-items-center text-hsp-ink transition-colors hover:text-hsp-teal"
               aria-label={s.name}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={s.d} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
