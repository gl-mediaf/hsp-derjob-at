---
const gruppe = [
  { text: 'hsp DIE FUNDRAISER GmbH',              href: '/' },
  { text: 'hsp Fundraising GmbH',                 href: 'https://www.hsp.at/' },
  { text: 'hsp Data Service GmbH',                href: 'https://www.hsp-data.at/' },
  { text: 'hsp Serviceline Telefonmarketing GmbH',href: 'https://www.hsp-serviceline.at/' },
  { text: 'Marco Marketing & Communication GmbH', href: 'http://www.marconet.at/' },
];
const derJob = [
  { text: 'Was ist Fundraising', href: '/fundraising' },
  { text: 'Geld machen',         href: '/geld' },
  { text: 'Organisationen',      href: '/organisationen' },
  { text: 'Erlebnis',            href: '/erlebnis' },
];
