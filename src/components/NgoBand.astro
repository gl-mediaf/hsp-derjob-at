---
import Bild from './Bild.astro';
import masse from '../data/bildmasse.json';

/**
 * Partnerband: das Oesterreichische Rote Kreuz auf einem Einsatzfoto.
 *
 * Vorher stand hier nur ein kleines Logo auf grauer Flaeche - viel Platz,
 * wenig Wirkung. Jetzt traegt ein abgedunkeltes Foto die Sektion, das Logo
 * sitzt mittig auf weisser Karte.
 *
 * Der Bildausschnitt ist bewusst so gewaehlt, dass die Person links neben der
 * Karte steht und nicht dahinter verschwindet.
 *
 * Das Foto liegt als CSS-Hintergrund auf dem Abschnitt - wie bei FotoBand.
 * Ein <img> dahinter wurde in Chrome nicht geladen, solange es hinter dem
 * Inhalt lag. Fuer schmale Fenster gibt es eine kleinere Fassung, umgeschaltet
 * wird in global.css ueber .fotoband.
 */
export interface Props {
  titel?:      string;
  unterzeile?: string;
  bild?:       string;
}
const {
  titel      = 'Unterwegs für',
  unterzeile = 'die größte Non-Profit-Organisation Österreichs',
  bild       = '/images/ngo-band.webp',
} = Astro.props;

const name    = bild.replace(/^\//, '').replace(/\.webp$/, '');
const eintrag = (masse as Record<string, { stufen: number[] }>)[name];
const klein   = eintrag?.stufen?.includes(1024)
  ? `/images/g/${name.replace(/\//g, '_')}-1024.webp`
  : bild;

const scrim = 'rgba(0,0,0,0.46)';
const stil  = [
  `--band-verlauf:linear-gradient(${scrim}, ${scrim})`,
  `--band-klein:url('${klein}')`,
  `--band-gross:url('${bild}')`,
  'background-position:center',
].join(';');
---

<section class="fotoband bg-hsp-ink bg-cover bg-no-repeat py-14 text-white sm:py-20"
         style={stil} aria-labelledby="ngo-titel">
  <div class="container-hsp text-center">

    <p class="text-[19px] leading-snug text-white/90 sm:text-[22px]">{titel}</p>

    <div class="mx-auto mt-5 w-fit rounded-2xl bg-white/95 px-10 py-8 shadow-[0_10px_40px_rgba(0,0,0,0.25)] sm:px-14 sm:py-10">
      <Bild src="/images/ngo-oerk.webp"
            alt="Logo des Österreichischen Roten Kreuzes"
            sizes="(min-width: 640px) 200px, 150px"
            class="h-[110px] w-auto object-contain sm:h-[150px]" />
    </div>

    <h2 id="ngo-titel"
        class="mx-auto mt-7 max-w-[720px] text-[22px] font-bold leading-snug text-white sm:text-[28px]">
      {unterzeile}
    </h2>

  </div>
</section>
