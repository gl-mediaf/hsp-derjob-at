---
import LogoSlider from './LogoSlider.astro';

/**
 * Partnerband.
 *
 * Bei genau einem Logo waere ein Slider sinnlos. Frueher standen Titel und
 * Logo nebeneinander in einer schmalen Zeile - das Logo war dabei so klein,
 * dass man es kaum erkannte. Da das Oesterreichische Rote Kreuz in Oesterreich
 * eine Institution ist, steht der Titel jetzt darueber und das Logo gross
 * darunter.
 */
export interface Props { titel?: string }
const { titel = 'Unterwegs für die größte NGO Österreichs:' } = Astro.props;

const ngos = [
  { src: '/images/ngo-oerk.webp', alt: 'Logo des Österreichischen Roten Kreuzes' },
];
const einzeln = ngos.length === 1;
---

{einzeln ? (
  <section class="border-y border-black/[0.06] bg-hsp-light py-10 sm:py-14" aria-labelledby="ngo-titel">
    <div class="container-hsp text-center">
      <h2 id="ngo-titel"
          class="mb-6 text-[17px] font-bold leading-snug text-hsp-body sm:mb-8 sm:text-[20px]">
        {titel}
      </h2>
      <img src={ngos[0].src} alt={ngos[0].alt} width="600" height="400" loading="lazy" decoding="async"
           class="mx-auto h-24 w-auto object-contain sm:h-32 lg:h-36" />
    </div>
  </section>
) : (
  <section class="bg-hsp-light pb-8 pt-[35px]" aria-labelledby="ngo-titel">
    <div class="container-hsp">
      <h2 id="ngo-titel" class="mb-8 text-center text-[17px] leading-6 text-hsp-ink sm:text-[20px]">
        {titel}
      </h2>
      <LogoSlider id="ngo-slider" logos={ngos} hoehe="h-24 sm:h-24 lg:h-28"
                  abstand="sm:gap-x-10 sm:gap-y-6" intervall={3000} />
    </div>
  </section>
)}
