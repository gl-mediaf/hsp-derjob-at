---
import LogoSlider from './LogoSlider.astro';

/**
 * Partnerband.
 *
 * Bei mehreren Logos laeuft der Slider. Bei genau einem Logo waere der Slider
 * sinnlos - dort stand eine fast leere Flaeche mit Punktnavigation fuer ein
 * einziges Element. Deshalb in dem Fall eine kompakte Zeile: Text und Logo
 * nebeneinander, deutlich weniger Hoehe.
 */
export interface Props { titel?: string }
const { titel = 'Unterwegs für die größte NGO Österreichs:' } = Astro.props;

const ngos = [
  { src: '/images/ngo-oerk.webp', alt: 'Logo des Österreichischen Roten Kreuzes' },
];
const einzeln = ngos.length === 1;
---

{einzeln ? (
  <section class="border-y border-black/[0.06] bg-hsp-light py-7 sm:py-9" aria-labelledby="ngo-titel">
    <div class="container-hsp flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-8">
      <h2 id="ngo-titel" class="text-center text-[16px] leading-snug text-hsp-body sm:text-[18px]">
        {titel}
      </h2>
      <img src={ngos[0].src} alt={ngos[0].alt} width="600" height="400" loading="lazy" decoding="async"
           class="h-14 w-auto object-contain sm:h-16" />
    </div>
  </section>
) : (
  <section class="bg-hsp-light pb-8 pt-[35px]" aria-labelledby="ngo-titel">
    <div class="container-hsp">
      <h2 id="ngo-titel" class="mb-8 text-center text-[17px] leading-6 text-hsp-ink sm:text-[20px]">
        {titel}
      </h2>
      <LogoSlider id="ngo-slider" logos={ngos} hoehe="h-24 sm:h-24 lg:h-28"
                  abstand="sm:gap-x-10 sm:gap-y-6" intervall={3000} />
    </div>
  </section>
)}
