---
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "hsp – Der Ferienjob mit dem gewissen Etwas",
  description = "Ø 3.300 € in 4 Wochen. Für den guten Zweck von Tür zu Tür. Das ist für dich drin – jetzt anfragen.",
  ogImage = new URL("/images/og-image.jpg", Astro.site).href,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---
<!DOCTYPE html>
<html lang="de-AT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1B2A4A" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Solange nur die Platzhalterseite steht: nicht indexieren lassen.
         Vor dem Livegang der echten Inhalte entfernen. -->
    <meta name="robots" content="noindex, nofollow" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- OG / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:site_name" content="hsp – Die Fundraiser" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

  </head>
  <body class="bg-white text-hsp-dark antialiased overflow-x-hidden">
    <slot />
  </body>
</html>
