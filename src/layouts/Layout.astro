---
import AnfrageDialog from '../components/AnfrageDialog.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Ferienjob mit Sinn: NGOs helfen & gutes Geld machen!",
  description = "Starte jetzt deinen flexiblen Ferienjob als Fundraiser: Geld machen, reisen, neue Leute treffen und NGOs unterstützen. Jetzt anfragen!",
  ogImage = new URL("/images/og-image.webp", Astro.site).href,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---
<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#319ea3" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Solange die Seite noch nicht offiziell live ist: nicht indexieren lassen.
         Vor dem Umzug der Domain entfernen (auch public/robots.txt). -->
    <meta name="robots" content="noindex, nofollow" />

    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Hausschrift vorladen: verhindert den Schriftsprung beim ersten Rendern -->
    <link rel="preload" href="/fonts/BundaySlab-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/BundaySlab-Light.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="hsp – Die Fundraiser" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <!-- Markiert, dass JavaScript läuft. Erst dann werden Sektionen zum Einblenden
         versteckt — ohne JS bleibt die Seite vollständig sichtbar. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="bg-white">
    <a href="#inhalt"
       class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100]
              focus:rounded-lg focus:bg-hsp-teal focus:px-4 focus:py-2 focus:text-white">
      Zum Inhalt springen
    </a>
    <slot />

    <AnfrageDialog />

    <script is:inline>
      // Sektionen beim Hereinscrollen einblenden
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          els.forEach(function (e) { e.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
          // Grosszuegig vorladen, damit bei schnellem Scrollen keine leeren
          // Flaechen sichtbar werden.
        }, { rootMargin: '300px 0px 300px 0px' });
        els.forEach(function (e) { io.observe(e); });
      })();

      // Logo-Slider: auf dem Handy eins nach dem anderen, automatisch wechselnd
(function () {
    if (window.__hspSliderInit) return;
    window.__hspSliderInit = true;

    function start() {
      var langsam = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      document.querySelectorAll('[data-slider]').forEach(function (spur) {
        var punkte = document.querySelector('[data-punkte="' + spur.id + '"]');
        var timer = null;

        function aktuellerIndex() {
          var karte = spur.querySelector('li');
          if (!karte || !karte.offsetWidth) return 0;
          return Math.round(spur.scrollLeft / karte.offsetWidth);
        }

        function punkteAktualisieren() {
          if (!punkte) return;
          var i = aktuellerIndex();
          [].forEach.call(punkte.children, function (p, n) {
            p.className = 'h-2 w-2 rounded-full transition-colors ' +
                          (n === i ? 'bg-hsp-teal' : 'bg-black/20');
          });
        }

        function weiter() {
          // Ab sm liegen die Logos nebeneinander, dann nicht scrollen
          if (window.innerWidth >= 640) return;
          var karte = spur.querySelector('li');
          if (!karte) return;
          var naechster = aktuellerIndex() + 1;
          if (naechster >= spur.children.length) naechster = 0;
          spur.scrollTo({ left: naechster * karte.offsetWidth, behavior: 'smooth' });
        }

        function starten() {
          if (langsam || timer) return;
          timer = setInterval(weiter, parseInt(spur.dataset.intervall, 10) || 3000);
        }
        function stoppen() {
          clearInterval(timer);
          timer = null;
        }

        spur.addEventListener('scroll', punkteAktualisieren, { passive: true });
        // Beim Wischen oder Zeigen pausieren, danach weiterlaufen
        ['pointerdown', 'mouseenter', 'focusin'].forEach(function (e) {
          spur.addEventListener(e, stoppen);
        });
        ['pointerup', 'mouseleave', 'focusout'].forEach(function (e) {
          spur.addEventListener(e, starten);
        });

        punkteAktualisieren();
        starten();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }
  })();
    </script>
    <script is:inline>
      // ══ Anfrageformular: gilt fuer jede Fassung auf der Seite ══
      (function () {
        var texte = {
          vorname:    'Bitte trag deinen Vornamen ein',
          nachname:   'Bitte trag deinen Nachnamen ein',
          email:      'Bitte pr\u00fcf deine E-Mail-Adresse',
          telefon:    'Bitte trag eine Telefonnummer ein',
          motivation: 'Schreib uns bitte zwei bis drei S\u00e4tze'
        };

        document.querySelectorAll('[data-anfrage-formular]').forEach(function (form) {
          var status = form.querySelector('[data-status]');
          var knopf  = form.querySelector('[data-senden]');
          var text   = form.querySelector('[data-senden-text]');
          var seite  = form.querySelector('[data-seite]');
          if (seite) seite.value = location.pathname;

          function meldung(art, inhalt) {
            status.hidden = false;
            status.textContent = inhalt;
            status.className = 'mt-4 rounded-xl px-4 py-3 text-[15px] font-bold ' +
              (art === 'ok' ? 'bg-hsp-teal/10 text-hsp-teal' : 'bg-red-50 text-hsp-red');
          }

          function feldFehler(namen) {
            form.querySelectorAll('[data-fehler]').forEach(function (p) {
              p.hidden = true;
              var feld = form.elements[p.getAttribute('data-fehler')];
              if (feld) feld.removeAttribute('aria-invalid');
            });
            (namen || []).forEach(function (n) {
              var p = form.querySelector('[data-fehler="' + n + '"]');
              var feld = form.elements[n];
              if (p) { p.textContent = texte[n] || 'Bitte pr\u00fcfen'; p.hidden = false; }
              if (feld) feld.setAttribute('aria-invalid', 'true');
            });
            if (namen && namen.length && form.elements[namen[0]]) form.elements[namen[0]].focus();
          }

          function zurueck() {
            text.textContent = 'Anfrage abschicken';
            knopf.disabled = false;
          }

          form.addEventListener('submit', function (e) {
            e.preventDefault();
            knopf.disabled = true;
            text.textContent = 'Wird gesendet \u2026';
            status.hidden = true;

            var daten = {};
            new FormData(form).forEach(function (wert, schluessel) { daten[schluessel] = wert; });

            fetch('/api/anfrage', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(daten)
            })
              .then(function (r) { return r.json(); })
              .then(function (j) {
                if (j && j.ok) {
                  form.querySelectorAll('input, textarea').forEach(function (i) {
                    if (i.type !== 'hidden') i.value = '';
                  });
                  feldFehler([]);
                  meldung('ok', 'Danke! Wir melden uns in der Regel innerhalb von 24 Stunden.');
                  zurueck();
                  return;
                }
                feldFehler(j && j.felder);
                meldung('fehler', (j && j.fehler) || 'Das hat nicht geklappt. Bitte versuch es nochmal.');
                zurueck();
              })
              .catch(function () {
                meldung('fehler', 'Keine Verbindung. Bitte versuch es gleich nochmal.');
                zurueck();
              });
          });
        });
      })();

      // ══ Formular als Overlay oeffnen ══
      (function () {
        var dialog = document.getElementById('anfrage-dialog');
        if (!dialog || typeof dialog.showModal !== 'function') return;

        function oeffnen(e) {
          if (e) e.preventDefault();
          dialog.showModal();
          var erstes = dialog.querySelector('input:not([type=hidden]):not([tabindex="-1"])');
          if (erstes) setTimeout(function () { erstes.focus(); }, 60);
        }

        // Jeder Knopf, der bisher zum Formular gesprungen ist, oeffnet jetzt das
        // Overlay. Ohne JavaScript bleibt der Sprung als Rueckfalloption bestehen.
        document.querySelectorAll('a[href="#anfrage"], [data-anfrage]').forEach(function (el) {
          el.addEventListener('click', oeffnen);
        });

        dialog.querySelectorAll('[data-dialog-schliessen]').forEach(function (b) {
          b.addEventListener('click', function () { dialog.close(); });
        });

        // Klick auf die abgedunkelte Flaeche schliesst ebenfalls
        dialog.addEventListener('click', function (e) {
          if (e.target === dialog) dialog.close();
        });
      })();
    </script>
  </body>
</html>
